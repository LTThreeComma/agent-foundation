          "type": "string"
        },
        "max_bytes": {
          "default": 16777216,
          "maximum": 67108864,
          "minimum": 65536,
          "title": "Max Bytes",
          "type": "integer"
        },
        "timeout": {
          "default": 5,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout",
          "type": "number"
        }
      },
      "title": "Objects",
      "type": "object"
