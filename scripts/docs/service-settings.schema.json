{
  "$defs": {
    "Database": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "default": "**********",
          "format": "password",
          "title": "Url",
          "type": "string",
          "writeOnly": true
        },
        "auto_migrate": {
          "default": true,
          "title": "Auto Migrate",
          "type": "boolean"
        },
        "pool_size": {
          "default": 5,
          "maximum": 100,
          "minimum": 1,
          "title": "Pool Size",
          "type": "integer"
        },
        "connect_timeout": {
          "default": 5,
          "maximum": 60,
          "minimum": 1,
          "title": "Connect Timeout",
          "type": "integer"
        },
        "statement_timeout": {
          "default": 10,
          "maximum": 300,
          "minimum": 1,
          "title": "Statement Timeout",
          "type": "integer"
        },
        "migration_advisory_lock_timeout": {
          "default": 900,
          "maximum": 3600,
          "minimum": 1,
          "title": "Migration Advisory Lock Timeout",
          "type": "integer"
        },
        "migration_lock_timeout": {
          "default": 3,
          "maximum": 60,
          "minimum": 1,
          "title": "Migration Lock Timeout",
          "type": "integer"
        },
        "migration_statement_timeout": {
          "default": 900,
          "maximum": 3600,
          "minimum": 1,
          "title": "Migration Statement Timeout",
          "type": "integer"
        },
        "migration_idle_transaction_timeout": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "title": "Migration Idle Transaction Timeout",
          "type": "integer"
        }
      },
      "title": "Database",
      "type": "object"
    },
    "Server": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8000,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "readiness_timeout": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Readiness Timeout",
          "type": "number"
        },
        "shutdown_timeout": {
          "default": 15,
          "maximum": 300,
          "minimum": 1,
          "title": "Shutdown Timeout",
          "type": "integer"
        }
      },
      "title": "Server",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "server": {
      "$ref": "#/$defs/Server"
    },
    "database": {
      "$ref": "#/$defs/Database"
    }
  },
  "title": "Settings",
  "type": "object"
}
