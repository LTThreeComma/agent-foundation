            "type": "string"
          },
          "title": "Return Urls",
          "type": "array"
        },
        "flow_seconds": {
          "default": 600,
          "maximum": 1800,
          "minimum": 30,
          "title": "Flow Seconds",
          "type": "integer"
        },
        "operation_seconds": {
          "default": 8,
          "maximum": 30,
          "minimum": 2,
          "title": "Operation Seconds",
          "type": "number"
        },
        "scan_seconds": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Scan Seconds",
          "type": "number"
        }
      },
