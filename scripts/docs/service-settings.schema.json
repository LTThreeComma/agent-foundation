        "request_bytes": {
          "default": 2097152,
          "maximum": 33554432,
          "minimum": 1024,
          "title": "Request Bytes",
          "type": "integer"
        },
        "request_timeout": {
          "default": 10,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Request Timeout",
          "type": "number"
        },
        "readiness_timeout": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Readiness Timeout",
          "type": "number"
        },
        "shutdown_timeout": {
          "default": 15,
          "maximum": 300,
          "minimum": 1,
          "title": "Shutdown Timeout",
          "type": "integer"
        },
