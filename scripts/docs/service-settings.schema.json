      "additionalProperties": false,
      "properties": {
        "url": {
          "default": "**********",
          "format": "password",
          "title": "Url",
          "type": "string",
          "writeOnly": true
        },
        "timeout": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Timeout",
          "type": "number"
        }
      },
      "title": "RedisSettings",
      "type": "object"
    },
