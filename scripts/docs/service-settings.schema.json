          "type": "integer"
        },
        "stream_bytes": {
          "default": 1048576,
          "maximum": 16777216,
          "minimum": 1024,
          "title": "Stream Bytes",
          "type": "integer"
        },
        "stream_entry_bytes": {
          "default": 65536,
          "maximum": 1048576,
          "minimum": 1024,
          "title": "Stream Entry Bytes",
          "type": "integer"
