          "type": "array"
        },
        "private_cidrs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Private Cidrs",
          "type": "array"
        },
        "http_origins": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Http Origins",
          "type": "array"
