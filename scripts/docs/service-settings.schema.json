{
  "$defs": {
    "Authentication": {
      "additionalProperties": false,
      "properties": {
        "session_seconds": {
          "default": 43200,
          "maximum": 604800,
          "minimum": 60,
          "title": "Session Seconds",
          "type": "integer"
        },
        "login_limit": {
          "default": 10,
          "maximum": 1000,
          "minimum": 1,
          "title": "Login Limit",
          "type": "integer"
        },
        "login_window_seconds": {
          "default": 60,
          "maximum": 3600,
          "minimum": 1,
          "title": "Login Window Seconds",
          "type": "integer"
        }
      },
      "title": "Authentication",
      "type": "object"
    },
    "Control": {
      "additionalProperties": false,
      "properties": {
        "scan_seconds": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Scan Seconds",
          "type": "number"
        },
        "inbox_count": {
          "default": 128,
          "maximum": 10000,
          "minimum": 1,
          "title": "Inbox Count",
          "type": "integer"
        },
        "inbox_bytes": {
          "default": 1048576,
          "maximum": 16777216,
          "minimum": 1024,
          "title": "Inbox Bytes",
          "type": "integer"
        }
      },
      "title": "Control",
      "type": "object"
    },
    "Database": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "default": "**********",
          "format": "password",
          "title": "Url",
          "type": "string",
          "writeOnly": true
        },
        "auto_migrate": {
          "default": true,
          "title": "Auto Migrate",
          "type": "boolean"
        },
        "pool_size": {
          "default": 5,
          "maximum": 100,
          "minimum": 1,
          "title": "Pool Size",
          "type": "integer"
        },
        "connect_timeout": {
          "default": 5,
          "maximum": 60,
          "minimum": 1,
          "title": "Connect Timeout",
          "type": "integer"
        },
        "statement_timeout": {
          "default": 10,
          "maximum": 300,
          "minimum": 1,
          "title": "Statement Timeout",
          "type": "integer"
        },
        "migration_advisory_lock_timeout": {
          "default": 900,
          "maximum": 3600,
          "minimum": 1,
          "title": "Migration Advisory Lock Timeout",
          "type": "integer"
        },
        "migration_lock_timeout": {
          "default": 3,
          "maximum": 60,
          "minimum": 1,
          "title": "Migration Lock Timeout",
          "type": "integer"
        },
        "migration_statement_timeout": {
          "default": 900,
          "maximum": 3600,
          "minimum": 1,
          "title": "Migration Statement Timeout",
          "type": "integer"
        },
        "migration_idle_transaction_timeout": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "title": "Migration Idle Transaction Timeout",
          "type": "integer"
        }
      },
      "title": "Database",
      "type": "object"
    },
    "Encryption": {
      "additionalProperties": false,
      "properties": {
        "active_key_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Key Id"
        },
        "keys": {
          "additionalProperties": {
            "format": "password",
            "type": "string",
            "writeOnly": true
          },
          "title": "Keys",
          "type": "object"
        }
      },
      "title": "Encryption",
      "type": "object"
    },
    "OAuth": {
      "additionalProperties": false,
      "properties": {
        "callback_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback Url"
        },
        "return_urls": {
          "default": [],
